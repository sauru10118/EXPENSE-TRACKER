# Port for local development and hosting (Render provides PORT automatically)
PORT=3000

# Authentication credentials (default: shree / sweri)
APP_USERNAME="shree"
APP_PASSWORD="sweri"

# Aiven Online PostgreSQL Cloud Database URI
# Format: postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST.aivencloud.com:PORT/defaultdb?sslmode=require
DATABASE_URL="postgres://avnadmin:YOUR_AIVEN_PASSWORD@YOUR_AIVEN_HOST.aivencloud.com:12345/defaultdb?sslmode=require"

# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (e.g. https://my-expense-tracker.onrender.com)
APP_URL="http://localhost:3000"


